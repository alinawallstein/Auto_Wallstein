DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# E-Mail: ohne EMAIL_HOST nur Konsolenbetrieb, keine echte Zustellung.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=verkauf@auto-wallstein.de
INQUIRY_NOTIFICATION_EMAIL=verkauf@auto-wallstein.de
# Optionaler Override, z. B. django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=

# Microsoft 365: values go ONLY into a private server file, outside this checkout.
# EMAIL_BACKEND=vehicles.graph_mail.EmailBackend
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_MAILBOX=verkauf@auto-wallstein.de
# MAIL_ENV_FILE=/home/YOUR_USERNAME/.config/auto-wallstein/mail.env

# WebMobil24: Token nur lokal in .env eintragen, niemals committen.
# Test und Produktion verwenden getrennte, vom Anbieter freigegebene Tokens.
WEBMOBIL24_ENV=test
WEBMOBIL24_TOKEN=
# Über den lesenden Befehl --list-dealers ermitteln.
WEBMOBIL24_DEALER_ID=
WEBMOBIL24_TIMEOUT=15
